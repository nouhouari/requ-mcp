# The image ships "to * by self read by admin write by * none": the service
# account cannot search and a user bound as themselves cannot read ou=groups.
# Grant the service account and every authenticated user read access, which is
# what a corporate directory that works with requ looks like.
dn: olcDatabase={1}{{ LDAP_BACKEND }},cn=config
changetype: modify
replace: olcAccess
olcAccess: {0}to attrs=userPassword,shadowLastChange by self write by dn="cn=admin,{{ LDAP_BASE_DN }}" write by anonymous auth by * none
olcAccess: {1}to * by self read by dn="cn=admin,{{ LDAP_BASE_DN }}" write by dn.exact="cn={{ LDAP_READONLY_USER_USERNAME }},{{ LDAP_BASE_DN }}" read by users read by * none
