# Copy to .env next to docker-compose.yml (cp env.example .env). Never commit the copy.

# --- Required -----------------------------------------------------------------
# Database password. Keep it URL-safe (letters, digits, - _ . ~): it is embedded
# in the connection URL requ receives.
PG_PASSWORD=

# Directory on this host that holds the repositories requ inspects. It is
# mounted read-only at /workspace, so a repo at $REQU_WORKSPACE_DIR/my-app is
# /workspace/my-app to requ (that is the path to give init_project).
REQU_WORKSPACE_DIR=

# --- Optional -----------------------------------------------------------------
# Image to run. Pin REQU_TAG to a version (e.g. 2.0.0) for reproducible deploys.
# REQU_IMAGE=ghcr.io/nouhouari/requ-mcp
# REQU_TAG=latest

# Host interface and port for the dashboard + MCP endpoint.
# 127.0.0.1 keeps it local (reverse proxy recommended); 0.0.0.0 exposes it.
# REQU_BIND=127.0.0.1
# REQU_PORT=8788

# Database name and user.
# PG_USER=requ
# PG_DB=requ
