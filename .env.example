# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# Directory on the host holding your repos. Mounted read-only at /workspace in
# the requ-mcp container, so projects must record conductorPath as /workspace/...
REQU_WORKSPACE_DIR=/absolute/path/to/your/projects

# Port the dashboard and /mcp endpoint are published on.
REQU_PORT=8788

# PostgreSQL credentials. Choose a real password; these are not defaults.
PG_USER=requ
PG_PASSWORD=
PG_DB=requ
PG_PORT=5433

# ---------------------------------------------------------------------------
# Authentication and authorisation
# ---------------------------------------------------------------------------
# 'disabled' (default) — no login, every caller has full access. For development.
# 'ldap'               — users sign in against your directory. For production.
REQU_AUTH_MODE=disabled

# Signs session cookies and peppers stored token hashes. REQUIRED when
# REQU_AUTH_MODE=ldap; at least 32 characters. Changing it signs everyone out
# and invalidates every access token.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REQU_AUTH_SECRET=

# Record every action and every specification change.
# 'auto' (default) follows REQU_AUTH_MODE; 'on'/'off' decide explicitly.
REQU_AUDIT=auto

# Role given to a user no group mapping matched. Any role id — the seeded ones
# are viewer, contributor, maintainer, admin, product-owner,
# requirements-analyst, qa and developer, and you can define your own in the
# Access tab — or 'none' to refuse the sign-in outright.
REQU_AUTH_DEFAULT_ROLE=viewer

# Usernames that are always admin, so a fresh install has a way in.
# REQU_AUTH_ADMINS=alice,bob

# Dashboard session lifetime, and the default lifetime of new access tokens
# (0 = tokens do not expire on their own).
REQU_AUTH_SESSION_TTL_HOURS=12
REQU_AUTH_TOKEN_TTL_DAYS=0

# Where auth, audit and change-history tables live when REQU_PG_URL is not set.
# With Postgres configured they share that database and this is ignored.
# REQU_AUTH_DB=/var/lib/requ/auth.db

# --- Two-factor authentication (TOTP) ---
# Microsoft Authenticator, Google Authenticator, 1Password, Authy — any app that
# scans a standard otpauth:// QR code. Needs REQU_AUTH_MODE=ldap.
#   off       (default) not offered
#   optional  anyone may enrol
#   required  everyone must; sign-in leads to enrolment until they have
REQU_2FA=off

# Require it only for certain roles, while leaving REQU_2FA=optional for
# everyone else — "anyone may, administrators must".
# REQU_2FA_REQUIRED_ROLES=admin,maintainer

# Name shown beside the account in the authenticator app.
# REQU_2FA_ISSUER=requ

# --- LDAP (only read when REQU_AUTH_MODE=ldap) ---
# ldaps:// is required unless you set REQU_LDAP_ALLOW_PLAINTEXT=true.
# REQU_LDAP_URL=ldaps://ldap.example.com:636
# REQU_LDAP_BASE_DN=dc=example,dc=com

# Service account used to find the user before binding as them. Leave both blank
# for anonymous search, or set REQU_LDAP_USER_DN_TEMPLATE to skip the search.
# REQU_LDAP_BIND_DN=cn=requ-service,ou=services,dc=example,dc=com
# REQU_LDAP_BIND_PASSWORD=

# How a login name is matched. The default covers OpenLDAP and Active Directory.
# REQU_LDAP_USER_FILTER=(|(uid={{username}})(sAMAccountName={{username}}))
# REQU_LDAP_USER_DN_TEMPLATE=uid={{username}},ou=people,dc=example,dc=com

# Group discovery: memberOf on the user entry is tried first, then this search.
# REQU_LDAP_MEMBEROF_ATTR=memberOf
# REQU_LDAP_GROUP_BASE_DN=ou=groups,dc=example,dc=com
# REQU_LDAP_GROUP_FILTER=(|(member={{dn}})(memberUid={{username}}))
# REQU_LDAP_GROUP_ATTR=cn

# Directory group -> requ role. Separate entries with ';' when a group is
# written as a full DN, and with ',' otherwise. The role may be any role id,
# including one you defined yourself; a name that matches no role grants nothing
# and is reported on startup.
# REQU_LDAP_ROLE_MAP=requ-admins=admin;requ-analysts=requirements-analyst;requ-qa=qa

# Only for a directory with a certificate you trust but cannot verify.
# REQU_LDAP_TLS_REJECT_UNAUTHORIZED=true
# REQU_LDAP_TIMEOUT_MS=5000
